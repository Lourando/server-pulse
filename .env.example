# Пример настроек Server Pulse.
# Скопируйте этот файл в .env и поменяйте значения под свою систему.
# Сам .env в репозиторий не попадает (он указан в .gitignore).

# Название сервиса: показывается в / и в /docs
APP_NAME=Server Pulse

# Подробность логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Пороги в процентах, при превышении которых /alerts сообщает о проблеме
CPU_ALERT_PERCENT=90
RAM_ALERT_PERCENT=85
DISK_ALERT_PERCENT=90

# Температура датчика (°C), выше которой /temperature считает его горячим
TEMP_ALERT_CELSIUS=80

# Диск для /alerts и значение по умолчанию для /disk.
# Если не указан: корень системы ("/" на Linux, "C:\" на Windows)
# DISK_PATH=/

# Процессы, которые должны быть запущены, через запятую.
# На Windows имя пишется без .exe
WATCHED_PROCESSES=sshd
